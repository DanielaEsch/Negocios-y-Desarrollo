server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    include /etc/nginx/security-headers.conf;

    # La API va al backend; el navegador solo ve un origen y no hay CORS.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # index.html sin cache para que cada despliegue se vea de inmediato.
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
    }

    # Archivos con hash en el nombre: cache larga.
    location ~* \.(?:js|css|woff2?|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
    }

    # Rutas del frontend (SPA): todo lo que no es archivo cae en index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
